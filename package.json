{
  "name": "contestly-services",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @contestly/shared -w @contestly/game -w @contestly/queue -w @contestly/db -w @contestly/payments -w @contestly/email -w @contestly/auth -w @contestly/storage",
    "test": "npm test -w @contestly/shared -w @contestly/game -w @contestly/email -w @contestly/payments -w @contestly/questions -w @contestly/api -w @contestly/realtime",
    "sim": "npm run sim:sealed && npm run sim:curate && npm run sim:stakes && npm run sim:climb && npm run sim:onboarding && npm run sim:admin && npm run sim:chat && npm run sim:social && npm run sim:payments",
    "sim:sealed": "tsx --env-file=.env scripts/party-sim.ts",
    "sim:curate": "tsx --env-file=.env scripts/party-sim-curate.ts",
    "sim:stakes": "tsx --env-file=.env scripts/stakes-sim.ts",
    "sim:climb": "tsx --env-file=.env scripts/climb-sim.ts",
    "dev:bots": "tsx --env-file=.env scripts/dev-bots.ts",
    "infra:up": "docker compose up -d --wait postgres valkey storage mailpit firebase-auth",
    "infra:down": "docker compose down",
    "db:generate": "npm run generate -w @contestly/db --",
    "db:migrate": "npm run migrate -w @contestly/db",
    "db:baseline": "npm run baseline -w @contestly/db",
    "db:seed": "npm run seed -w @contestly/db",
    "db:dev-admins": "npm run dev-admins -w @contestly/db",
    "dev": "concurrently -n api,rt,worker,questions -c blue,magenta,yellow,cyan \"npm run dev -w @contestly/api\" \"npm run dev -w @contestly/realtime\" \"npm run dev -w @contestly/worker\" \"npm run dev -w @contestly/questions\"",
    "build": "npm run prepare && npm run build -w apps --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim:onboarding": "tsx --env-file=.env scripts/onboarding-sim.ts",
    "test:int": "npm run test:int -w @contestly/api",
    "sim:admin": "tsx --env-file=.env scripts/admin-sim.ts",
    "sim:chat": "tsx --env-file=.env scripts/chat-sim.ts",
    "sim:social": "tsx --env-file=.env scripts/social-sim.ts",
    "probe:firebase-custom-tokens": "tsx --env-file=.env scripts/firebase-custom-token-probe.ts",
    "sim:payments": "tsx --env-file=.env scripts/payments-sim.ts",
    "paystack:check": "tsx --env-file=.env scripts/paystack-check.ts",
    "payments:break-glass": "tsx --env-file-if-exists=.env scripts/payments-break-glass.ts"
  },
  "devDependencies": {
    "colyseus.js": "^0.15.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
