{
  "name": "contestly-services",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @contestly/shared -w @contestly/game -w @contestly/db -w @contestly/queue -w @contestly/auth",
    "test": "npm test -w @contestly/game",
    "sim": "tsx --env-file=.env scripts/party-sim.ts",
    "infra:up": "docker compose up -d --wait postgres valkey",
    "infra:down": "docker compose down",
    "db:push": "npm run push -w @contestly/db",
    "db:seed": "npm run seed -w @contestly/db",
    "dev": "concurrently -n api,rt,worker -c blue,magenta,yellow \"npm run dev -w @contestly/api\" \"npm run dev -w @contestly/realtime\" \"npm run dev -w @contestly/worker\"",
    "build": "npm run prepare && npm run build -w apps --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "colyseus.js": "^0.15.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}