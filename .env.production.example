# Copy to .env on the droplet and fill in. Never commit the filled-in file.
NODE_ENV=production

# Public names for the two services Caddy serves. Without a domain, sslip.io names any IP:
#   api.<ip-with-dashes>.sslip.io and rt.<ip-with-dashes>.sslip.io
API_HOST=api.example.com
RT_HOST=rt.example.com
API_PUBLIC_URL=https://api.example.com

# DO Managed Postgres and Valkey ("Connection details"; private hostnames when in the same VPC as the droplet).
# Add the droplet to each cluster's Trusted Sources. Valkey is TLS: rediss://
DATABASE_URL=postgresql://doadmin:PASSWORD@private-HOST.db.ondigitalocean.com:25060/defaultdb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@private-HOST.db.ondigitalocean.com:25061

API_PORT=4000
REALTIME_PORT=4001
TRUST_PROXY=1

# The Render sites (comma-separated, no trailing slash). WEB_ORIGIN is the CORS allow-list.
WEB_ORIGIN=https://contestly-web.onrender.com,https://contestly-mobile-web.onrender.com
PUBLIC_WEB_URL=https://contestly-mobile-web.onrender.com
AUTH_RETURN_URLS=contestly://auth,https://contestly-mobile-web.onrender.com/auth

# Auth (ADR 0006). dev is refused in production.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=
# Long random values: openssl rand -hex 32
EMAIL_CODE_SECRET=
PHONE_HASH_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

EMAIL_TRANSPORT=zeptomail
EMAIL_PRIMARY=zeptomail
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Contestly
ZEPTOMAIL_TOKEN=
BREVO_API_KEY=

# DO Spaces
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

QUESTIONS_GENERATOR=mock
QUESTIONS_VERIFIER=mock
QUESTIONS_EMBEDDER=mock
