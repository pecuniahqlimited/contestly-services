{
  "name": "@contestly/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nudges": {
      "types": "./dist/nudges.d.ts",
      "import": "./dist/nudges.js",
      "default": "./dist/nudges.js"
    },
    "./moderation": {
      "types": "./dist/moderation.d.ts",
      "import": "./dist/moderation.js",
      "default": "./dist/moderation.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "default": "./dist/templates.js"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "import": "./dist/brands.js",
      "default": "./dist/brands.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js",
      "default": "./dist/images.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
