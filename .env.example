# Copy to .env — every service reads this file from the repo root.
DATABASE_URL=postgres://contestly:contestly@localhost:5432/contestly
REDIS_URL=redis://localhost:6379

API_PORT=4000
REALTIME_PORT=4001
# Comma-separated: the Vite web app and the Expo web build.
WEB_ORIGIN=http://localhost:5173,http://localhost:8081
# Base of the web link in a party's invite (…/p/<id>). Nothing serves it until deploy (roadmap step 11).
PUBLIC_WEB_URL=https://contestly.invalid

# Auth (ADR 0006). Firebase only issues sessions: anonymous ones from the first screen, and custom tokens we mint
# after a sign-in. "firebase" verifies ID tokens only. "dev" also accepts `x-dev-user: <handle>` (local work, sims)
# and is refused when NODE_ENV=production.
AUTH_MODE=dev
# The Firebase project is config only: the dev project (or the emulator) locally, the live Contestly project in production.
FIREBASE_PROJECT_ID=demo-contestly
# Local: the Auth emulator from docker compose (no credentials). Unset it to use a real project.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# A service account JSON (one line) that can mint custom tokens. Unset with the emulator; a secret in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Accounts with these verified emails get the admin role (comma-separated). Grant only.
ADMIN_EMAILS=
# db:seed (dev only) makes these demo handles admins.
DEV_ADMIN_HANDLES=tunde
# Secrets for the email-code HMAC and the phone-number HMAC. Required in production; any value locally.
EMAIL_CODE_SECRET=dev-email-code-secret
PHONE_HASH_SECRET=dev-phone-hash-secret

# Google and Apple sign-in run over the system browser and come back to the API, then to the app.
# Public base URL of this API (the providers' redirect URI is <API_PUBLIC_URL>/auth/oauth/<provider>/callback).
API_PUBLIC_URL=http://localhost:4000
# Where the browser may be sent back to (comma-separated): the app's deep link and the web app's /auth page.
AUTH_RETURN_URLS=contestly://auth,https://play.contestlyapp.com/auth,http://localhost:8081/auth
# Without these, AUTH_MODE=dev uses a stand-in provider page; outside dev the provider is unavailable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key's contents; "\n" for line breaks is fine.
APPLE_PRIVATE_KEY=
# Rate limits (apps/api/src/limits.ts has the production defaults and why). Signed-in requests count per user,
# signed-out ones per client IP. Dev sets them high so `npm run sim` can run all eight sims at once.
RATE_LIMIT_USER_PER_MINUTE=100000
RATE_LIMIT_IP_PER_MINUTE=100000
RATE_LIMIT_CODE_SENDS_PER_IP_PER_HOUR=100000
RATE_LIMIT_CODE_SENDS_PER_EMAIL_PER_HOUR=1000
RATE_LIMIT_CODE_CHECKS_PER_IP_PER_10_MIN=100000
RATE_LIMIT_CODE_CHECKS_PER_EMAIL_PER_10_MIN=1000
RATE_LIMIT_OAUTH_PER_IP_PER_10_MIN=100000
RATE_LIMIT_GUESTS_PER_IP_PER_HOUR=100000
RATE_LIMIT_REPORTS_PER_HOUR=1000
# Not a limit: an admin alert (warning, code_sends_spike) when sign-in codes sent in one clock hour, everyone
# together, pass this. Production default 2000; dev high so the sims don't raise it.
ALERT_CODE_SENDS_PER_HOUR=100000
# Admin alerts (adminAlert() in packages/db; the worker delivers them, apps/worker/src/alertDelivery.ts).
# Critical: emailed at once (one message per kind, then that kind waits ADMIN_ALERT_THROTTLE_MINUTES; what piles
# up goes next time, the first ADMIN_ALERT_LIST_MAX listed and then "and N more"). Warning: an email digest at
# most every ADMIN_ALERT_DIGEST_MINUTES. Info: the console's list only. Empty ADMIN_ALERT_EMAILS: no email.
# Dev: Mailpit catches this address; check with POST /admin/alerts/test { "severity": "critical" }.
ADMIN_ALERT_EMAILS=alerts@dev.contestly.invalid
# Dev: 1 minute, so a test warning shows up quickly (the production default is 30).
ADMIN_ALERT_DIGEST_MINUTES=1
ADMIN_ALERT_THROTTLE_MINUTES=10
ADMIN_ALERT_LIST_MAX=5
ADMIN_ALERT_RETRY_MINUTES=1
# Optional: a Slack-compatible incoming webhook ({ "text": … }), critical only unless SEVERITY=warning (then the digest too).
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_WEBHOOK_SEVERITY=critical
# Payments alerts (kinds payments.*) in full, with ids, amounts and provider answers: only to these. The general
# channels above get just their subject and a console link. Dev: Mailpit catches this address.
ADMIN_ALERT_PAYMENTS_EMAILS=payments@dev.contestly.invalid
# Optional: a Slack-compatible webhook for payments alerts only (same severity rule as ADMIN_ALERT_WEBHOOK_SEVERITY).
ADMIN_ALERT_PAYMENTS_WEBHOOK_URL=
# The admin console's base URL, for those links (default: PUBLIC_WEB_URL + /admin).
ADMIN_CONSOLE_URL=
# Money transactions: how long one after-commit effect (a publish, later a push) may hold the caller, in ms.
# Past it the caller moves on and an after_commit_effect_timeout warning is raised. Default 5000.
AFTER_COMMIT_EFFECT_TIMEOUT_MS=5000
# Realtime rooms: messages per second per connection (dropped above it), and how long over it before the
# connection is closed. Production defaults (20, 5) are in apps/realtime/src/messageCap.ts.
ROOM_MESSAGES_PER_SECOND=20
ROOM_FLOOD_DISCONNECT_SECONDS=5
# The real client IP comes from CF-Connecting-IP only through a trusted proxy (apps/api/src/clientIp.ts).
# Caddy's address(es) as seen by the API, comma-separated (IPs or CIDRs). Empty locally: the socket address is used.
TRUSTED_PROXY_IPS=
# Cloudflare's ranges; unset uses the published list built into clientIp.ts.
# CLOUDFLARE_IPS=

# Email: ZeptoMail primary, Brevo backup (the admin console switches which sends first). Keys never go in admin.
# Locally EMAIL_TRANSPORT=mailpit sends everything to the Mailpit inbox (http://localhost:8025) instead.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
EMAIL_PRIMARY=zeptomail
EMAIL_FROM_ADDRESS=codes@contestly.local
EMAIL_FROM_NAME=Contestly
ZEPTOMAIL_TOKEN=
BREVO_API_KEY=

# Object storage (S3 API) for media people keep (avatars, covers, voice notes; party source files are
# never stored). Locally: the SeaweedFS container from docker-compose, with its dev-only credentials.
# Production: DO Spaces, keys from the secrets manager — never committed.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=contestly-dev
S3_ACCESS_KEY_ID=contestly-dev
S3_SECRET_ACCESS_KEY=contestly-dev-secret
S3_FORCE_PATH_STYLE=true

# AI providers for the question engine and voice-note transcription: see the end of this file (ADR 0016).

# A second stack beside this one (a worktree) needs its own: DATABASE_URL database, TEST_DATABASE_NAME, the db index
# in REDIS_URL and TEST_REDIS_DB (default 15), BULLMQ_PREFIX (default "bull"), PUBSUB_PREFIX, API_PORT/REALTIME_PORT, and API_URL/RT_URL for the sims.
# BULLMQ_PREFIX=bull
# Valkey pub/sub ignores the db index: PUBSUB_PREFIX namespaces party:events and admin:events (default empty).
# Staging and production set different ones if they ever share a Valkey.
# PUBSUB_PREFIX=
# TEST_DATABASE_NAME=contestly_test
# TEST_REDIS_DB=15

# Payments (ADR 0013). The default provider is mock with the dev tools on (paystack otherwise) until an admin
# picks one at /admin/payments/settings; PAYMENTS_PROVIDER overrides that default. Secrets live here, never in admin.
# Outside production a live key (sk_live_…) anywhere, or a PAYSTACK_SECRET_KEY that isn't sk_test_…, refuses to start.
# PAYMENTS_PROVIDER=mock
# The mock provider, its checkout page and POST /wallet/dev-topup exist only with this set to true, and never
# when NODE_ENV=production whatever it says. Local dev and the sims need it; staging and production leave it unset.
PAYMENTS_DEV_TOOLS=true
PAYSTACK_SECRET_KEY=
# Where checkout sends the person back (the app then polls GET /wallet/topups/:reference).
PAYMENTS_RETURN_URL=
# true: webhooks only from the provider's published addresses.
PAYMENTS_WEBHOOK_IP_ALLOWLIST=false
# Refused webhooks from one address beyond this a minute get 429, unstored (providers' own addresses exempt).
# PAYMENTS_WEBHOOK_REFUSALS_PER_IP_PER_MINUTE=30
# The mock provider's webhook signing secret: required with the dev tools on (there is no default). Any value locally.
MOCK_PAYMENTS_WEBHOOK_SECRET=local-mock-webhook-secret
# npm run paystack:check: the test top-up's customer email (required; a real address, never a reserved test domain),
# and a test account to resolve and send to (defaults 057 / 0000000000).
# PAYSTACK_TEST_EMAIL=
# PAYSTACK_TEST_BANK_CODE=
# PAYSTACK_TEST_ACCOUNT_NUMBER=

# OPT-IN probe (npm run probe:firebase-custom-tokens -- --run; scripts/firebase-custom-token-probe.ts): does
# signing in with custom tokens for new uids count against Firebase's 100 new accounts per IP per hour?
# A real dev/staging project only; it refuses the production id, and refuses to run without it.
FIREBASE_PRODUCTION_PROJECT_ID=
PROBE_FIREBASE_PROJECT_ID=
PROBE_FIREBASE_SERVICE_ACCOUNT_JSON=
PROBE_FIREBASE_WEB_API_KEY=
# Push (row 9; the worker). log (default): records what would be sent. fcm: FCM HTTP v1 through Firebase Admin,
# with FIREBASE_SERVICE_ACCOUNT_JSON, through PUSH_FIREBASE_PROJECT_ID (default FIREBASE_PROJECT_ID). Outside
# production fcm needs FIREBASE_PRODUCTION_PROJECT_ID (above) and refuses to send through that project.
PUSH_PROVIDER=log
PUSH_FIREBASE_PROJECT_ID=
# Support contacts the app shows (GET /config). Empty: the app hides them. WhatsApp in E.164 (+234…).
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# AI providers (ADR 0016). Mocks by default; set the keys and pick the real ones to use them. A real provider
# without its key stops the service at start. Never logged. Per-step models (generate, verify, safety) and the
# spend caps are admin config (/admin/questions/providers), not env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QUESTIONS_GENERATOR=mock         # mock | anthropic
QUESTIONS_VERIFIER=mock          # mock | live   (live: the admin's verify model picks the vendor; Claude + web search by default,
                                 #                Gemini + Google Search needs a billing-enabled Gemini project)
QUESTIONS_EMBEDDER=mock          # mock | gemini (changing it re-embeds the bank in the background)
QUESTIONS_SAFETY=mock            # mock | live   (the model check after the term filter; Claude Haiku by default)
TRANSCRIBER=mock                 # mock | gemini (worker: voice notes into the moderation transcript)
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_RPM=90              # embed requests a minute per process (Gemini's free tier allows 100)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
