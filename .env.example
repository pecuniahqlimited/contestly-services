# Copy to .env — every service reads this file from the repo root.
DATABASE_URL=postgres://contestly:contestly@localhost:5432/contestly
REDIS_URL=redis://localhost:6379

API_PORT=4000
REALTIME_PORT=4001
WEB_ORIGIN=http://localhost:5173

# Auth. "dev" trusts an x-dev-user header (handle) so you can work without Firebase.
# Set to "firebase" and provide FIREBASE_PROJECT_ID + GOOGLE_APPLICATION_CREDENTIALS for real tokens.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# Question engine providers. Only "mock" exists today; a real provider is a new file + this env change.
QUESTIONS_GENERATOR=mock
QUESTIONS_VERIFIER=mock
QUESTIONS_EMBEDDER=mock

# Payments (unused locally; the ledger runs without Paystack)
PAYSTACK_SECRET_KEY=
